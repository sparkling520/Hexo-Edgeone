- const { nav, owner, copyright, custom_text } = theme.footer

if nav
  .footer-flex
    for block in nav
      .footer-flex-items(style=`${ block.width ? 'flex-grow:' + block.width : '' }`)
        for blockItem in block.content
          .footer-flex-item
            .footer-flex-title= blockItem.title
            .footer-flex-content
              for subitem in blockItem.item
                if subitem.html
                  div!= subitem.html
                else if subitem.url
                  a(href=url_for(subitem.url), target='_blank' title=subitem.title)= subitem.title
                else if subitem.title
                  div!= subitem.title
.footer-other
  .footer-copyright
    if owner.enable
      - const currentYear = new Date().getFullYear()
      - const sinceYear = owner.since
      span.copyright
        span.footer-badge-copyright.footer-badge-custom
          span.footer-badge-label ©
          span.footer-badge-value #{sinceYear}-#{currentYear}
        != ` By ${config.title}`
    if copyright.enable
      - const v = copyright.version ? getVersion() : false
      - const hexoVer = v ? v.hexo : '8.1.2'
      - const themeVer = v ? v.theme : '5.6.0'
      span.framework-info
        a(href='https://hexo.io' target='_blank' title='Hexo')
          img.footer-badge(src=`https://img.shields.io/badge/框架-Hexo%20${hexoVer}-3B82F6?style=flat-square` alt='Hexo')
        span.footer-separator |
        a(href='https://github.com/jerryc127/hexo-theme-butterfly' target='_blank' title='Butterfly')
          img.footer-badge(src=`https://img.shields.io/badge/主题-Butterfly%20${themeVer}-F47421?style=flat-square` alt='Butterfly')
    span.footer-badge-group
      span#runtime-footer.footer-badge-custom
        span.footer-badge-label 本站已运行
        span.footer-badge-value
          span#runtime-days 0
          |  天 
          span#runtime-hours 0
          |  小时 
          span#runtime-mins 0
          |  分 
          span#runtime-secs 0
          |  秒
    span.footer-badge-group
      a(href='http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=23022902000116' rel='noreferrer' target='_blank')
        span.footer-badge-custom
          span.footer-badge-label
            img.beian-badge-icon(src='/img/beian.png' alt='')
            | 黑公网安备
          span.footer-badge-value.beian-value 23022902000116
      a(href='https://beian.miit.gov.cn' target='_blank')
        img.footer-badge(src='https://img.shields.io/badge/黑ICP备-2025036541号--2-006f1d?style=flat-square' alt='ICP备案')
  if theme.footer.custom_text
    .footer_custom_text!= theme.footer.custom_text
